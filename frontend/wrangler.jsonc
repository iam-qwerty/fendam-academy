{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fendam-academy",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],

  // Environment variables (non-secret defaults; secrets set via `wrangler secret put`)
  "vars": {
    "APP_URL": "https://academy.fendamtech.com",
    "VITE_APP_URL": "https://academy.fendamtech.com",
    "VITE_API_URL": "https://academy-api.fendamtech.com"
  },

  // Secrets (set via `wrangler secret put <NAME>`):
  //   DATABASE_URL       — Neon PostgreSQL connection string
  //   BETTER_AUTH_SECRET — Auth encryption key
  //   GOOGLE_CLIENT_ID   — Google OAuth client ID
  //   GOOGLE_CLIENT_SECRET
  //   GITHUB_CLIENT_ID   — GitHub OAuth client ID
  //   GITHUB_CLIENT_SECRET
  //   RESEND_API_KEY     — Resend email API key
  //   RESEND_FROM_EMAIL  — Sender email for Resend
  //   VITE_SENTRY_DSN    — Sentry project DSN
  //   SENTRY_AUTH_TOKEN  — Sentry auth token for source maps (build-time only)

  "observability": {
    "logs": {},
    "traces": {
      "enabled": true
    },
    "enabled": true,
    "head_sampling_rate": 1
  }
}
